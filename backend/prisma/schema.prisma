// This is your Prisma schema file.
// Neon PostgreSQL connection configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     String @default("USER")
}

model Vehicle {
  id           Int      @id @default(autoincrement())
  make         String
  model        String
  year         Int
  price        Float
  mileage      Int?
  fuelType     String?
  transmission String?
  color        String?
  stock        Int      @default(1)
  description  String?
  imageUrl     String?
  status       String   @default("AVAILABLE")
  category     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
